# Copy to `.env` (git-ignored) and fill in. Read by docker compose and deploy_local.sh;
# Spring Boot picks the values up as environment variables. Never commit real secrets.

# --- Database (MySQL 8.4) ---
FXMIND_DB_URL=jdbc:mysql://localhost:3306/fxmind
FXMIND_DB_USER=fxmind
FXMIND_DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- First administrator (created only if no ADMIN exists; min. 12 characters) ---
FXMIND_ADMIN_EMAIL=admin@example.com
FXMIND_ADMIN_PASSWORD=

# --- MetaTrader bridge ---
FXMIND_THRIFT_PORT=2011
FXMIND_BROKER_TIME_ZONE=EET

# --- Web ---
PORT=8080
FXMIND_PUBLIC_URL=http://localhost:8080

# --- Optional SMTP (registration mails); leave SPRING_MAIL_HOST unset to disable ---
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
FXMIND_MAIL_FROM=fxmind-noreply@example.com
